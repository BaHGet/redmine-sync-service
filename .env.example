# ─── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Redmine / WebDAV ───────────────────────────────────
REDMINE_URL=https://redmine.yourcompany.com
REDMINE_API_KEY=your_redmine_api_key_here

WEBDAV_URL=https://redmine.yourcompany.com/dmsf/webdav
WEBDAV_USERNAME=your_webdav_username
WEBDAV_PASSWORD=your_webdav_password

# The WebDAV path to scan (default set in code if omitted)
WEBDAV_ROOT_PATH="/Documents Repository/CRM Documents/Requirements CRM/Requirements/Requirements"

# ─── Google Drive ───────────────────────────────────────
# 1. Create a folder in Google Drive named "redmine_requirements"
# 2. Copy its ID from the URL and paste it here
GDRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# Paste the full contents of your service account JSON key file (stringified / single line)
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Database ───────────────────────────────────────────
POSTGRES_USER=syncuser
POSTGRES_PASSWORD=syncpass
POSTGRES_DB=redmine_sync
# Use localhost when running outside Docker, postgres when inside docker-compose
DATABASE_URL=postgresql://syncuser:syncpass@localhost:5432/redmine_sync

# ─── Redis / BullMQ ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── AI Export ──────────────────────────────────────────
# Path inside the container where the JSON export file will be written
AI_EXPORT_PATH=/app/exports

# ─── AdminJS UI ─────────────────────────────────────────
# Login credentials for the /admin dashboard
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=a-strong-password-here
# Must be at least 32 characters
ADMIN_COOKIE_SECRET=change-this-to-a-long-random-secret-string-here
